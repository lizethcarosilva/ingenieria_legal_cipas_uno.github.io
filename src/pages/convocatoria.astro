  <style is:global>
    /* ── Hero floating docs ── */
    .cv-doc { animation: cvfloat 7s ease-in-out infinite; }
    .cv-d1  { animation-duration: 7s;   animation-delay:  0s; }
    .cv-d2  { animation-duration: 5.5s; animation-delay: -2s; }
    .cv-d3  { animation-duration: 8.5s; animation-delay: -4s; }
    @keyframes cvfloat {
      0%,100% { transform: translateY(0)     rotate(-4deg); }
      50%      { transform: translateY(-12px) rotate( 4deg); }
    }

    /* ── Definition cards entrance ── */
    @media (prefers-reduced-motion: no-preference) {
      .cv-card {
        animation: cvin 0.55s cubic-bezier(0.22,1,0.36,1) both;
      }
      .cv-card:nth-child(1) { animation-delay: .05s; }
      .cv-card:nth-child(2) { animation-delay: .13s; }
      .cv-card:nth-child(3) { animation-delay: .21s; }
      .cv-card:nth-child(4) { animation-delay: .29s; }
    }
    @keyframes cvin {
      from { opacity:0; transform: translateY(18px) scale(.97); }
      to   { opacity:1; transform: translateY(0)    scale(1);   }
    }
    .cv-card {
      transition: transform .3s cubic-bezier(.34,1.45,.64,1), box-shadow .3s ease;
    }
    .cv-card:hover {
      transform: translateY(-5px) scale(1.02);
      box-shadow: 0 14px 28px -10px rgba(15,23,42,.18);
    }

    /* ── Contract cards shimmer effect ── */
    .cv-contract-card::after {
      content: '';
      position: absolute; inset: 0;
      background: linear-gradient(115deg, transparent 0%, rgba(255,255,255,.3) 50%, transparent 70%);
      transform: translateX(-130%);
      animation: cvshine 8s ease-in-out infinite;
      pointer-events: none;
      mix-blend-mode: soft-light;
    }
    @keyframes cvshine {
      0%,100% { transform: translateX(-130%); }
      40%,60%  { transform: translateX( 130%); }
    }

    /* ── Modal ── */
    #cv-modal.cv-open { display: flex; animation: cvmodalIn .2s ease; }
    @keyframes cvmodalIn {
      from { opacity: 0; transform: scale(.97); }
      to   { opacity: 1; transform: scale(1);   }
    }

    @media (prefers-reduced-motion: reduce) {
      .cv-doc, .cv-contract-card::after { animation: none; }
      .cv-card { animation: none; }
    }
  </style>

  <script is:inline>
  (function () {
    const modal   = document.getElementById('cv-modal');
    const iframe  = document.getElementById('cv-modal-iframe');
    const title   = document.getElementById('cv-modal-title');
    const closeBtn= document.getElementById('cv-modal-close');
    if (!modal || !iframe) return;

    function openModal(pdf, label) {
      title.textContent = label;
      iframe.src = pdf;
      modal.classList.add('cv-open');
      document.body.style.overflow = 'hidden';
    }
    function closeModal() {
      modal.classList.remove('cv-open');
      iframe.src = 'about:blank';
      document.body.style.overflow = '';
    }

    document.querySelectorAll('.cv-preview-btn').forEach(btn => {
      btn.addEventListener('click', () => openModal(btn.dataset.pdf, btn.dataset.title));
    });
    closeBtn.addEventListener('click', closeModal);
    modal.addEventListener('click', e => { if (e.target === modal) closeModal(); });
    document.addEventListener('keydown', e => { if (e.key === 'Escape') closeModal(); });
  })();
  </script>
</Page>
