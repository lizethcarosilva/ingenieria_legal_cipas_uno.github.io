        <p id="cv-modal-title" class="text-sm font-bold text-neutral-800 truncate pr-4"></p>
        <button type="button" id="cv-modal-close" class="rounded-lg border border-neutral-200 bg-white p-2 text-neutral-600 hover:bg-red-50 hover:text-red-600 transition" aria-label="Cerrar vista previa">
